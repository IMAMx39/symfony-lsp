<?xml version="1.0" encoding="utf-8"?>
<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
  <parameters>
    <parameter key="kernel.project_dir">/var/www/html</parameter>
    <parameter key="kernel.environment">dev</parameter>
    <parameter key="kernel.debug">true</parameter>
    <parameter key="kernel.secret">%env(APP_SECRET)%</parameter>
    <parameter key="app.sender">noreply@example.com</parameter>
    <parameter key="app.empty"/>
    <parameter key="kernel.enabled_locales" type="collection">
      <parameter>en</parameter>
      <parameter>fr</parameter>
    </parameter>
    <parameter key="event_dispatcher.event_aliases" type="collection">
      <parameter key="Symfony\Component\HttpKernel\Event\RequestEvent">kernel.request</parameter>
    </parameter>
    <parameter key=".kernel.bundles_definition" type="collection">
      <parameter key="FrameworkBundle" type="collection"/>
    </parameter>
  </parameters>
  <services>
    <service id="service_container" class="Symfony\Component\DependencyInjection\ContainerInterface" public="true" synthetic="true"/>
    <service id="App\Service\Mailer" class="App\Service\Mailer" autowire="true" autoconfigure="true">
      <argument>noreply@example.com</argument>
      <argument type="service" id="mailer.transport" on-invalid="ignore_uninitialized"/>
      <argument type="service" id="logger"/>
    </service>
    <service id="App\Service\Newsletter" class="App\Service\Newsletter" autowire="true" autoconfigure="true">
      <argument type="service" id="App\Service\Mailer"/>
    </service>
    <service id="app.newsletter" class="App\Service\Newsletter" autowire="true" autoconfigure="true">
      <argument type="service" id="App\Service\Mailer"/>
      <argument type="service">
        <service class="App\Service\InlineHelper"/>
      </argument>
      <tag name="app.tag" ref="@app.mailer"/>
      <tag name="kernel.event_listener" event="kernel.request"/>
      <tag name="kernel.event_listener" event="kernel.response"/>
      <tag name="custom">app.named_tag</tag>
    </service>
    <service id="app.child_mailer" class="App\Service\Newsletter" autowire="true" autoconfigure="true"/>
    <service id="logger" class="\Symfony\Component\HttpKernel\Log\Logger">
      <tag name="kernel.reset" method="reset"/>
    </service>
    <service id="mailer.transport" class="Acme\FooBundle\Mailer\Transport"/>
    <service id="compiled.only" class="App\Service\Newsletter"/>
    <service id=".service_locator.Xyz123" class="Symfony\Component\DependencyInjection\ServiceLocator">
      <tag name="container.service_locator"/>
    </service>
    <service id="App\MessageHandler\CreateOrderHandler" class="App\MessageHandler\CreateOrderHandler" autowire="true" autoconfigure="true">
      <tag name="messenger.message_handler" bus="" handles="" method="" priority="0" sign="false" from_transport=""/>
    </service>
    <service id="App\MessageHandler\StaleHandler" class="App\MessageHandler\StaleHandler" autowire="true" autoconfigure="true">
      <tag name="messenger.message_handler" bus="" handles="" method="" priority="0" sign="false" from_transport=""/>
    </service>
    <service id="acme_foo.audit_handler" class="Acme\FooBundle\Messenger\AuditHandler">
      <tag name="messenger.message_handler"/>
    </service>
    <service id="acme_foo.cancel_logger" class="Acme\FooBundle\Messenger\AuditHandler">
      <tag name="messenger.message_handler" handles="App\Message\CancelOrder" method="logCancel"/>
    </service>
    <service id="acme_foo.locale_listener" class="Acme\FooBundle\EventListener\LocaleListener">
      <tag name="kernel.event_subscriber"/>
    </service>
    <service id="App\EventSubscriber\OrderSubscriber" class="App\EventSubscriber\OrderSubscriber" autowire="true" autoconfigure="true">
      <tag name="kernel.event_subscriber"/>
    </service>
    <service id="debug.event_dispatcher" class="Symfony\Component\HttpKernel\Debug\TraceableEventDispatcher">
      <call method="addListener">
        <argument>kernel.request</argument>
        <argument type="collection">
          <argument type="service_closure" id="acme_foo.locale_listener"/>
          <argument>onKernelRequest</argument>
        </argument>
        <argument>16</argument>
      </call>
      <call method="addListener">
        <argument>kernel.request</argument>
        <argument type="collection">
          <argument type="service_closure" id="App\EventSubscriber\OrderSubscriber"/>
          <argument>onRemovedSinceTheDump</argument>
        </argument>
        <argument>0</argument>
      </call>
    </service>
    <service id="debug.security.event_dispatcher.main" class="Symfony\Component\HttpKernel\Debug\TraceableEventDispatcher">
      <call method="addListener">
        <argument>Acme\FooBundle\Event\PassportEvent</argument>
        <argument type="collection">
          <argument type="service_closure" id="acme_foo.locale_listener"/>
          <argument>checkPassport</argument>
        </argument>
        <argument>-1024</argument>
      </call>
    </service>
    <service id="app.mailer" alias="App\Service\Mailer" public="true"/>
    <service id="app.mailer_short" alias="app.mailer"/>
    <service id="Psr\Log\LoggerInterface" alias="logger"/>
    <service id="app.mailer.public" alias="compiled.only" public="true"/>
  </services>
</container>
